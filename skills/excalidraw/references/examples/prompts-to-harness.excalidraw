    {
      "id": "4btAyZ_UL6xZAw2cuBMaO",
      "type": "text",
      "x": 3265,
      "y": 225,
      "width": 389.2796630859375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "frameId": "U4yopliWhSk57_ID2Fcxo",
      "index": "auzzO",
      "boundElements": [],
      "text": "Requirements\n1. 24 hour agentic feature to bug\n2. New or existing code base\n3. Human readable memory and hand offs, each run\nhas its own context\n4. Eventual multi model and AI vendor support \n5. Move away from chatting - this is something\nbuilt for a generation of workers who googled\n6. Repeatable, evaluatable (run time, quality,\ndefect loops, did it work, how close did it come\nto original requirements)\n7. Learning project - to know a harness and\nfigure out where human in the loop should be,\nbest way to do it is to jump right in",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "EAT4DThWvo_hADYNPJ1sg",
      "originalText": "Requirements\n1. 24 hour agentic feature to bug\n2. New or existing code base\n3. Human readable memory and hand offs, each run has its own context\n4. Eventual multi model and AI vendor support \n5. Move away from chatting - this is something built for a generation of workers who googled\n6. Repeatable, evaluatable (run time, quality, defect loops, did it work, how close did it come to original requirements)\n7. Learning project - to know a harness and figure out where human in the loop should be, best way to do it is to jump right in",
      "autoResize": true,
      "lineHeight": 1.25,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "seed": 1,
      "groupIds": [],
      "roundness": null,
